# ---- GoHighLevel (obligatorio) ----
# Settings → Private Integrations → crear token con scopes:
#   contacts.readonly, contacts.write, invoices.readonly, invoices.write,
#   invoices/estimate.readonly, invoices/estimate.write, opportunities.readonly, opportunities.write,
#   conversations/message.write (correo de aviso al coordinador)
GHL_TOKEN=
GHL_LOCATION_ID=
# Para enviar el estimate por correo
GHL_USER_ID=
GHL_FROM_EMAIL=
GHL_FROM_NAME=Le Groupe Eco Air
# Pipeline y etapa "Soumission Sended" (opcional pero recomendado)
GHL_PIPELINE_ID=
GHL_STAGE_ID=
# false = modo prueba (no cobra ni envía de verdad)
GHL_LIVE_MODE=true

# ---- Acceso a la app ----
# Texto largo aleatorio (mín. 24 caracteres): openssl rand -base64 32
SESSION_SECRET=
# usuario:clave:rol:idUsuarioGHL:Nombre visible:correo  (separados por coma)
#   Solo se usa la PRIMERA vez para crear los usuarios en la base; después se manejan en Plus → Vendeurs.
#   rol: coord o support = administrador · seller = vendedor (solo ve lo suyo)
APP_USERS=nicolas:clave:coord:ID_GHL:Nicolas Ampère:nicolas@ejemplo.com,marie:clave:seller:ID_GHL:Marie
# URL pública de la app (enlaces al PDF en correos y SMS; si falta se usa el dominio de Vercel)
APP_URL=https://ecoair-soumissions.vercel.app
# Opcional: nombres de otros usuarios GHL para el historial (idGHL:Nombre, separados por coma)
GHL_USER_NAMES=

# ---- Base de datos (solicitudes e historial) ----
# La crea Vercel → Storage → Neon. En local, sin DATABASE_URL, se usa memoria.
DATABASE_URL=
